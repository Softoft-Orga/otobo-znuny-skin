# Copy to .env in this directory. Compose refuses to start without the password.
OTOBO_DB_ROOT_PASSWORD=change-me

# Host port. The UI is http://127.0.0.1:8111/otobo/installer.pl
OTOBO_WEB_HTTP_PORT=8111

# deployment | development | shotgun
OTOBO_WEB_OPTION=deployment

OTOBO_ELASTICSEARCH_ES_JAVA_OPTS=-Xms512m -Xmx512m
